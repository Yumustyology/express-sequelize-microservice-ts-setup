# ==============================
# Environment
# ==============================
NODE_ENV=development

# ==============================
# Service Config
# ==============================
SERVICE_PORT=4001

# ==============================
# MySQL Database (Local)
# ==============================
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASS=example
DB_NAME=users_db

# ==============================
# MySQL Database (Docker)
# Uncomment when running inside docker-compose
# ==============================
# DB_HOST=mysql-users
# DB_PORT=3306
# DB_USER=user
# DB_PASS=password
# DB_NAME=users_db

# ==============================
# RabbitMQ
# ==============================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ==============================
# Posts Service URL
# ==============================
# Local Dev
POSTS_SERVICE_URL=http://localhost:4002/api

# Inside Docker Network
# POSTS_SERVICE_URL=http://posts-service:4002/api

# ==============================
# Redis
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
