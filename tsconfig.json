{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    // "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@app/shared/*": ["shared/*"]
    }
  },
  "include": [
    "shared/**/*",
    "services/**/*"
  ]
}
